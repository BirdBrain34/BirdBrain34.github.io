---
const { selectedItem } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<aside
  data-animation="default"
  data-collapse="medium"
  data-duration="400"
  data-easing="ease"
  data-easing2="ease"
  role="banner"
  class="sidebar w-nav"
>
  <div class="nav-content">
    <a href={`${base}/`} class="w-nav-brand" aria-label="home">
      <div class="niv-data">
        <img
          src={`${base}/assets/Atendido.png`}
          loading="eager"
          fetchpriority="high"
          alt="Lance Atendido"
          class="niv-image"
          style="border-radius: 0; object-fit: contain; background: transparent;"
        />
        <div>
          <div class="label-white">Lance Atendido</div>
          <div class="label-gray">IT Student | Software & Game Developer</div>
        </div>
      </div>
    </a>

    <div class="sidebar-contact-links" style="display: flex; align-items: center; gap: 10px; margin: 4px 0 14px 2px;">
      <a href="mailto:lanceatendido34@gmail.com" aria-label="Email Lance" title="Email" style="color: #a8a8a8; display: inline-flex;">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" xmlns="http://www.w3.org/2000/svg">
          <path d="M2 6h20v12H2z"/>
          <path d="M22 6l-10 7L2 6"/>
        </svg>
      </a>
      <a href="https://github.com/BirdBrain34" target="_blank" rel="noopener noreferrer" aria-label="GitHub" title="GitHub" style="color: #a8a8a8; display: inline-flex;">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" xmlns="http://www.w3.org/2000/svg">
          <path d="M12 0C5.374 0 0 5.373 0 12c0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23A11.509 11.509 0 0112 5.803c1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576C20.566 21.797 24 17.3 24 12c0-6.627-5.373-12-12-12z"/>
        </svg>
      </a>
      <a href="https://linkedin.com/in/lance-atendido-769516401" target="_blank" rel="noopener noreferrer" aria-label="LinkedIn" title="LinkedIn" style="color: #a8a8a8; display: inline-flex;">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" xmlns="http://www.w3.org/2000/svg">
          <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.446-2.136 2.94v5.666H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/>
        </svg>
      </a>
    </div>

    <nav role="navigation" class="w-nav-menu">
      <a
        href={`${base}/`}
        class={`nav-link-container w-inline-block ${selectedItem === 'home' ? 'w--current' : ''}`}
      >
        <div class="nav-icon-slot">
          <img src={`${base}/assets/home.svg`} loading="eager" alt="" class="nav-link-image" />
        </div>
        <div>About Me</div>
      </a>

      <a
        href={`${base}/skills/`}
        class={`nav-link-container w-inline-block ${selectedItem === 'skills' ? 'w--current' : ''}`}
        aria-current={selectedItem === 'skills' ? 'page' : undefined}
      >
        <div class="nav-icon-slot">
          <img src={`${base}/assets/skills-icon.png`} loading="eager" alt="" class="nav-link-image" />
        </div>
        <div>Skills</div>
      </a>

      <a
        href={`${base}/personal-projects/`}
        class={`nav-link-container w-inline-block ${selectedItem === 'personal-projects' ? 'w--current' : ''}`}
      >
        <div class="nav-icon-slot">
          <img src={`${base}/assets/project-icon.png`} loading="eager" alt="" class="nav-link-image" style="filter: invert(1) brightness(2);" />
        </div>
        <div>Projects</div>
      </a>

      <a
        href={`${base}/experience/`}
        class={`nav-link-container w-inline-block ${selectedItem === 'experience' ? 'w--current' : ''}`}
        aria-current={selectedItem === 'experience' ? 'page' : undefined}
      >
        <div class="nav-icon-slot">
          <img
            src={`${base}/assets/experience.png`}
            loading="eager"
            alt=""
            class="nav-link-image experience-nav-icon"
            style="width: 30px; height: 30px; object-fit: contain; filter: invert(1) brightness(2);"
          />
        </div>
        <div>Experience</div>
      </a>

      <a
        href={`${base}/achievements/`}
        class={`nav-link-container w-inline-block ${selectedItem === 'achievements' ? 'w--current' : ''}`}
      >
        <div class="nav-icon-slot">
          <img src={`${base}/assets/achievements-icon.png`} loading="eager" alt="" class="nav-link-image" />
        </div>
        <div>Achievements</div>
      </a>

      <a
        href={`${base}/seminars/`}
        class={`nav-link-container w-inline-block ${selectedItem === 'seminars' ? 'w--current' : ''}`}
        aria-current={selectedItem === 'seminars' ? 'page' : undefined}
      >
        <div class="nav-icon-slot">
          <img src={`${base}/assets/seminars-icon.png`} loading="eager" alt="" class="nav-link-image" style="filter: invert(1) brightness(2);" />
        </div>
        <div>Seminars</div>
      </a>
    </nav>

    <div
      class="navbar-icon-button w-nav-button"
      style="-webkit-user-select: text;"
      aria-label="menu"
      role="button"
      tabindex="0"
    >
      <img src={`${base}/assets/menu.svg`} loading="eager" alt="" class="navbar-icon" />
    </div>
  </div>

  <script>
    import { setupNav } from '../scripts/nav.js';

    let cleanup;
    document.addEventListener('astro:page-load', () => {
      if (cleanup) cleanup();
      cleanup = setupNav();
    });

    document.addEventListener('astro:before-swap', () => {
      if (cleanup) cleanup();
    });

    // `.main` is the app's real scrolling container (see the comment at the
    // top of scripts/chips.js) — it's not `window`. Astro's client router
    // reuses/morphs this element across navigations instead of reloading
    // the page, so it keeps the old scroll position unless we reset it.
    // We do this on astro:after-swap (fires right after new content lands,
    // before the transition finishes) rather than astro:page-load, so the
    // reset happens *during* the transition instead of as a visible jump
    // right at the end of it.
    const resetScroll = () => {
      if (window.location.hash) return; // don't fight in-page anchor links
      document.querySelector('.main')?.scrollTo({ top: 0, left: 0, behavior: 'instant' });
    };
    document.addEventListener('astro:after-swap', resetScroll);
  </script>
</aside>